{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/martinderm/website-optimizer/schemas/links-report.schema.json",
  "title": "Internal Link Audit Report",
  "description": "The internal link graph of built output. Static only: a crawl sees part of a site, and a partial graph reports coverage as if it were architecture.",
  "type": "object",
  "allOf": [
    {"$ref": "report-base.schema.json"},
    {
      "type": "object",
      "required": ["source", "summary"],
      "properties": {
        "source": {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": {"enum": ["static_dir"]},
            "path": {"type": ["string", "null"]}
          }
        },
        "summary": {
          "type": "object",
          "required": [
            "audited_pages", "ignored_pages", "internal_links", "broken_targets",
            "unreachable_pages", "deep_pages",
            "total_critical_issues", "total_warnings"
          ],
          "additionalProperties": false,
          "properties": {
            "audited_pages": {"type": "integer", "minimum": 0},
            "ignored_pages": {"type": "integer", "minimum": 0},
            "internal_links": {"type": "integer", "minimum": 0},
            "broken_targets": {"type": "integer", "minimum": 0},
            "unreachable_pages": {"type": "integer", "minimum": 0},
            "deep_pages": {"type": "integer", "minimum": 0},
            "total_critical_issues": {"type": "integer", "minimum": 0},
            "total_warnings": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  ]
}
