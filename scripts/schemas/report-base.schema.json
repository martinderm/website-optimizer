{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/martinderm/website-optimizer/schemas/report-base.schema.json",
  "title": "Audit Report — common base",
  "description": "Fields every capability report carries. Capability-specific sections are added by the extending schema.",
  "type": "object",
  "required": ["report_version", "tool", "generated_at", "crawl_mode", "site", "capability", "rules_run", "findings"],
  "properties": {
    "report_version": {"type": "string", "minLength": 1},
    "capability": {"type": "string", "minLength": 1},
    "rules_run": {
      "type": "array",
      "description": "Every rule_id the capability could emit, fired or not. Without this, a clean page and a check that did not run look identical to a comparison.",
      "items": {"type": "string", "minLength": 1}
    },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"}
      }
    },
    "generated_at": {"type": "string", "minLength": 1},
    "crawl_mode": {"enum": ["static", "live"]},
    "crawl": {
      "type": "object",
      "description": "Present only for a live render. Carries what the crawl could and could not reach, so a run that saw half the site never reads as one that saw all of it.",
      "required": ["requested", "fetched", "failed", "limit", "retention_class"],
      "additionalProperties": false,
      "properties": {
        "requested": {"type": "integer", "minimum": 0},
        "fetched": {"type": "integer", "minimum": 0},
        "limit": {"type": "integer", "minimum": 0},
        "retention_class": {"const": "crawl-ephemeral"},
        "artifacts": {"type": ["string", "null"]},
        "failed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["url", "reason"],
            "additionalProperties": false,
            "properties": {
              "url": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "site": {
      "type": "object",
      "required": ["url", "domain"],
      "additionalProperties": false,
      "properties": {
        "url": {"type": "string"},
        "domain": {"type": "string"}
      }
    },
    "findings": {
      "type": "array",
      "description": "Atomic findings. A verdict is derived from these, never written into them.",
      "items": {
        "type": "object",
        "required": ["rule_id", "severity", "message", "observed", "expected", "subject", "location"],
        "additionalProperties": false,
        "properties": {
          "rule_id": {"type": "string", "minLength": 1},
          "severity": {"enum": ["critical", "warning"]},
          "message": {"type": "string", "minLength": 1},
          "observed": {},
          "expected": {},
          "subject": {"type": "string", "minLength": 1},
          "location": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}